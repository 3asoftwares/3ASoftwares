# Reference for the environment variables required in production.
# Set these directly in your hosting provider's dashboard (e.g. Vercel
# Project Settings -> Environment Variables) — do NOT commit a real
# .env.production file, since Next.js does not gitignore it by default.
#
# On a deployed (non-localhost) domain the app always resolves to
# Razorpay "live" mode (see getRazorpayModeFromHost in src/lib/razorpay.ts),
# so only the LIVE credentials below are needed in production.

# --- Database (MongoDB Atlas — production cluster) ---
MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/dbname?retryWrites=true&w=majority"

# --- Razorpay live keys ---
RAZORPAY_LIVE_KEY_ID="rzp_live_xxxxxxxxxx"
RAZORPAY_LIVE_KEY_SECRET="rzp_live_secret_xxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_LIVE_KEY_ID="rzp_live_xxxxxxxxxx"
