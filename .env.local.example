# Copy this file to .env.local for local development (npm run dev).
# .env.local is gitignored — never commit real secrets.
#
# On localhost the app always resolves to Razorpay "test" mode
# (see getRazorpayModeFromHost in src/lib/razorpay.ts), so only the
# TEST credentials below are needed for local dev.

# --- Database (MongoDB Atlas — use a dev/staging cluster or database) ---
MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/dbname-dev?retryWrites=true&w=majority"

# --- Razorpay test keys ---
RAZORPAY_TEST_KEY_ID="rzp_test_xxxxxxxxxx"
RAZORPAY_TEST_KEY_SECRET="rzp_test_secret_xxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_TEST_KEY_ID="rzp_test_xxxxxxxxxx"
