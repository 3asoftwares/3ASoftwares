# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Database (MongoDB Atlas) ---
MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/dbname?retryWrites=true&w=majority"

# Optional backward compatibility if any old scripts still read this key.
DATABASE_URL="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/dbname?retryWrites=true&w=majority"

# --- Razorpay test (used on localhost) ---
RAZORPAY_TEST_KEY_ID="rzp_test_xxxxxxxxxx"
RAZORPAY_TEST_KEY_SECRET="rzp_test_secret_xxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_TEST_KEY_ID="rzp_test_xxxxxxxxxx"

# --- Razorpay live (used on deployed domain) ---
RAZORPAY_LIVE_KEY_ID="rzp_live_xxxxxxxxxx"
RAZORPAY_LIVE_KEY_SECRET="rzp_live_secret_xxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_LIVE_KEY_ID="rzp_live_xxxxxxxxxx"

# Optional backward-compatible defaults
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxx"
RAZORPAY_KEY_SECRET="rzp_test_secret_xxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxx"

# Optional app base URL
BASE_URL="http://localhost:3000"
